# --- Telegram -------------------------------------------------------------
# Token issued by @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Proxy for Telegram API calls ONLY (marketplace requests always go out directly).
# Fill it in when the server cannot reach api.telegram.org, e.g. on Russian hosting.
# Formats: socks5://user:pass@host:1080 | http://host:3128 | socks5://host:1080
# TELEGRAM_PROXY=

# --- Redis ----------------------------------------------------------------
# Local run:            redis://localhost:6379/0
# docker compose run:   redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- Cache ----------------------------------------------------------------
# Product card TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# --- Networking -----------------------------------------------------------
# Per-request timeout for marketplace calls, seconds
REQUEST_TIMEOUT=15.0
# curl_cffi browser profile used for TLS/JA3 impersonation
IMPERSONATE=chrome124
# Max product image size to download and re-upload to Telegram, bytes
MAX_IMAGE_BYTES=10485760

# --- Anti-flood -----------------------------------------------------------
# Minimum seconds between two links from the same user
THROTTLE_RATE=1.5

# --- Misc -----------------------------------------------------------------
LOG_LEVEL=INFO
